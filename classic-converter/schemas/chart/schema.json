{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chart Block",
  "description": "A block that renders an ArcGIS chart resource",
  "type": "object",
  "properties": {
    "type": {
      "const": "chart"
    },
    "data": {
      "type": "object",
      "properties": {
        "chart": {
          "type": "string"
        }
      },
      "required": ["chart"],
      "additionalProperties": true
    },
    "config": {
      "type": ["object", "null"],
      "additionalProperties": true
    }
  },
  "required": ["type", "data"],
  "additionalProperties": true
}
