{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Word Cloud Block",
  "description": "A word cloud infographic block",
  "type": "object",
  "properties": {
    "type": {
      "const": "word-cloud"
    },
    "data": {
      "type": "object",
      "properties": {
        "wordResource": {
          "type": "string"
        },
        "rotations": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "orientations": {
          "type": "number"
        },
        "colors": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": ["wordResource"],
      "additionalProperties": true
    },
    "config": {
      "type": ["object", "null"],
      "additionalProperties": true
    }
  },
  "required": ["type", "data"],
  "additionalProperties": true
}
