{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Action Button Block",
  "description": "A sidecar narrative button that triggers an AGSM action",
  "type": "object",
  "properties": {
    "type": {
      "const": "action-button"
    },
    "data": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": ["text"],
      "additionalProperties": true
    },
    "config": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "dependents": {
      "type": "object",
      "properties": {
        "actionMedia": {
          "type": "string"
        }
      },
      "required": ["actionMedia"],
      "additionalProperties": true
    }
  },
  "required": ["type", "data"],
  "additionalProperties": true
}
