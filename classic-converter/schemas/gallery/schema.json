{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gallery Block",
  "description": "A block that renders a gallery of child image nodes",
  "type": "object",
  "properties": {
    "type": {
      "const": "gallery"
    },
    "data": {
      "type": "object",
      "properties": {
        "galleryLayout": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "config": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "children": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["type", "children"],
  "additionalProperties": true
}
