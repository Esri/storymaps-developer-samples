{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quiz Question Block",
  "type": "object",
  "properties": {
    "type": { "const": "quiz-question" },
    "data": {
      "type": "object",
      "properties": {
        "type": { "const": "single-select" },
        "question": { "type": "string" },
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" }
            },
            "required": ["id", "text"],
            "additionalProperties": true
          }
        },
        "correctAnswer": { "type": "string" }
      },
      "required": ["type", "question", "answers", "correctAnswer"],
      "additionalProperties": true
    },
    "config": { "type": ["object", "null"], "additionalProperties": true }
  },
  "required": ["type", "data"],
  "additionalProperties": true
}
